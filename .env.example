# Local development values only. Copy to .env: cp .env.example .env

# Superuser password for the Postgres container (docker-compose reads this).
POSTGRES_PASSWORD=owner_dev_password

# App runtime connection: the restricted app_user role (RLS applies).
# Its password here is also what db:migrate sets on the app_user role.
DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5433/tasks

# Migrations / setup connection: the owner role.
MIGRATION_DATABASE_URL=postgres://app_owner:owner_dev_password@localhost:5433/tasks

# Test database (same container, separate database).
TEST_DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5433/tasks_test
TEST_MIGRATION_DATABASE_URL=postgres://app_owner:owner_dev_password@localhost:5433/tasks_test
